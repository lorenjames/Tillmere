# Local server config (copy to .env and fill in your values)
PORT=3001
MIDDLETONS_API_BASE=http://localhost:3001

# MySQL connection (use either MYSQL_URL or the host/user/password/database set)
MYSQL_URL=mysql://user:password@localhost:3306/middletons_pos
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=yourpassword
# MYSQL_DATABASE=middletons_pos

# Optional data directory for JSON fallback
# MIDDLETONS_DATA_DIR=C:\Users\yourname\AppData\Roaming\middletons-pos

# Optional backup JSON path (from Reports > Export)
# MIDDLETONS_BACKUP_PATH=C:\Users\yourname\AppData\Roaming\middletons-pos\backups\middletons-backup-latest.json
# EXCLUDE_VOIDED=1
