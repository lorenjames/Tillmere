# Normalize text files to LF in repo; Windows scripts keep CRLF locally
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary formats as binary (no line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary

# SVG and JSON are text; keep LF
*.svg text eol=lf
*.json text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
